{
  "name": "recura-erp",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=esm --packages=external --sourcemap --outfile=dist/server.js && node scripts/copy-assets.js",
    "prestart": "test -f dist/server.js || npm run build || true",
    "start": "node dist/server.js",
    "preview": "vite preview",
    "clean": "node scripts/clean.js",
    "lint": "tsc --noEmit",
    "test": "node scripts/regression-test.js",
    "db:migrate": "tsx server/db/cli.ts migrate",
    "db:import": "tsx server/db/cli.ts import",
    "db:setup": "tsx server/db/cli.ts setup",
    "db:seed": "tsx server/db/cli.ts seed"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "esbuild": "^0.25.0",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "pg": "^8.23.0",
    "qrcode": "^1.5.4",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "tailwindcss": "^4.1.14"
  }
}
