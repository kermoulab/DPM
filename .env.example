# Required environment variables for Recura ERP.
# Copy this file to .env and set real values before starting the server.

# AES-256-GCM key for encrypting service account credentials.
# Must be exactly 64 hex characters (32 bytes).
# Generate: node -e "require('crypto').randomBytes(32).toString('hex') |> console.log"
ENCRYPTION_KEY="replace_with_64_hex_chars_random_key"

# Secret for HMAC-SHA256 session token signing.
# Must be at least 32 characters. Use a cryptographically random value.
# Generate: node -e "require('crypto').randomBytes(32).toString('hex') |> console.log"
JWT_SECRET="replace_with_strong_random_jwt_secret_minimum_32_chars"
