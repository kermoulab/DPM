# =============================================================================
# DPM — Digital Product Management System
# Environment Configuration Template
# =============================================================================
# Copy this file to .env and configure real values before starting the server.
# Run: cp .env.example .env (or 'copy .env.example .env' on Windows)
# =============================================================================

# ─── 1. SERVER CONFIGURATION ──────────────────────────────────────────────────
# The network port the Express application server listens on.
# On cloud platforms (e.g., Render, Railway), PORT is injected automatically.
PORT=3000

# Runtime environment: 'development' or 'production'.
# In production, missing secrets trigger hard startup failures and
# internal stack traces are suppressed.
NODE_ENV=development

# ─── 2. DATABASE CONFIGURATION (POSTGRESQL) ──────────────────────────────────
# Fully-qualified PostgreSQL connection URI.
# DPM works with any standard PostgreSQL server — local, Docker, or managed.
#
# Formats:
# Local / Docker PostgreSQL:
#   DATABASE_URL="postgresql://postgres:postgres@localhost:5432/dpm_erp"
# Any remote PostgreSQL (with SSL required in the URL):
#   DATABASE_URL="postgresql://user:password@host:5432/dpm_erp?sslmode=require"
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/dpm_erp"

# SSL / TLS Configuration
# Controls whether the backend connects to PostgreSQL over SSL/TLS.
#
# Resolution order (first match wins):
#   1. sslmode=require in DATABASE_URL  → SSL on
#   2. sslmode=disable in DATABASE_URL  → SSL off
#   3. DATABASE_SSL=true/1              → SSL on
#   4. DATABASE_SSL=false/0             → SSL off
#   5. Default                          → SSL off (safe for local development)
#
# For local PostgreSQL:      DATABASE_SSL=false  (or leave unset)
# For remote/managed PostgreSQL: DATABASE_SSL=true  (or add ?sslmode=require to DATABASE_URL)
# DATABASE_SSL=false

# When DATABASE_SSL is enabled, controls certificate verification.
# Set to false only if your PostgreSQL server uses a self-signed certificate.
# Default: true (certificate verification is ON)
# DATABASE_SSL_REJECT_UNAUTHORIZED=true

# Maximum number of clients in the PostgreSQL connection pool.
# Default: 20. Lower this on constrained database plans (e.g., free tiers).
# DATABASE_POOL_MAX=20

# ─── 3. SECURITY & CRYPTOGRAPHY SECRETS ───────────────────────────────────────
# AES-256-GCM Master Key for encrypting customer credentials and service account passwords.
# MUST be 64 hexadecimal characters (32 raw bytes).
# Generate using Node.js:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY="replace_with_64_hex_chars_random_key"

# Secret key used for signing and verifying HMAC-SHA256 JWT session tokens.
# MUST be at least 32 characters long.
# Generate using Node.js:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="replace_with_strong_random_jwt_secret_minimum_32_chars"

# ─── 4. OPTIONAL FRONTEND API BASE URL ────────────────────────────────────────
# Leave empty or omit if frontend and API are served from the same origin (default).
# If the React frontend is deployed separately (e.g., Vercel / Netlify / Cloudflare Pages),
# set this to the backend's public URL:
# VITE_API_URL="https://dpm-api.onrender.com"
